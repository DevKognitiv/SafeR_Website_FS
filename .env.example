# Supabase ------------------------------------------------------------
# Server-only (Vercel functions in /api). NEVER prefix with PUBLIC_/NEXT_PUBLIC_.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me-service-role-key

# Public (exposed to the browser via /api/config). Anon key is safe to ship.
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
PUBLIC_SUPABASE_ANON_KEY=replace-me-anon-key

# Analytics (optional) -------------------------------------------------
# Pick one. If unset, the analytics stub does nothing.
PUBLIC_PLAUSIBLE_DOMAIN=safer.ci
# PUBLIC_GA_ID=G-XXXXXXXXXX
